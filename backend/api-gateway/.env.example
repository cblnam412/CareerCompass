# API Gateway Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Backend Services URLs
AUTH_SERVICE_URL=http://localhost:5000
UNIVERSITY_SERVICE_URL=http://localhost:5001
MOCK_EXAMS_SERVICE_URL=http://localhost:5002
STUDENT_SERVICE_URL=http://localhost:5003
CONTENT_SERVICE_URL=http://localhost:5004
# QUIZ_SERVICE_URL=http://localhost:5002

# Redis
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=60

# Logging
LOG_LEVEL=info
MONITORING_MEMORY_LOG_LIMIT=200
SLOW_REQUEST_THRESHOLD_MS=5000

# Gmail alerting for abnormal server errors
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
ALERT_EMAIL_FROM=your-gmail@gmail.com
ADMIN_ALERT_EMAIL=admin-gmail@gmail.com
ALERT_COOLDOWN_MS=300000

# Timeout (in milliseconds)
REQUEST_TIMEOUT=30000
